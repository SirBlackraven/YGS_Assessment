{
  "openapi": "3.0.1",
  "info": {
    "title": "YGS_URLTracker",
    "version": "1.0"
  },
  "paths": {
    "/shorten": {
      "post": {
        "tags": [
          "Url"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortenRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortenRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ShortenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ShortenResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortenResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{shortUrl}": {
      "get": {
        "tags": [
          "Url"
        ],
        "parameters": [
          {
            "name": "shortUrl",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/analytics/{shortUrl}": {
      "get": {
        "tags": [
          "Url"
        ],
        "parameters": [
          {
            "name": "shortUrl",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UrlRecord"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlRecord"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlRecord"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShortenRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ShortenResponse": {
        "type": "object",
        "properties": {
          "shortUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UrlRecord": {
        "type": "object",
        "properties": {
          "originalUrl": {
            "type": "string",
            "nullable": true
          },
          "shortenedUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "clickCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      }
    }
  }
}